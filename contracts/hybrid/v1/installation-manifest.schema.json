{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masseyslab.github.io/cleanupsuite/contracts/hybrid/v1/installation-manifest.schema.json",
  "title": "CleanupSuite Matched Hybrid Installation Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "suiteVersion",
    "protocolVersion",
    "publisher",
    "authenticodeRequired",
    "components"
  ],
  "properties": {
    "manifestVersion": {"const": "1.0"},
    "suiteVersion": {"$ref": "#/$defs/version"},
    "protocolVersion": {"const": "1.0"},
    "publisher": {"const": "MasseysLab"},
    "authenticodeRequired": {"const": true},
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "allOf": [
        {
          "contains": {
            "properties": {"id": {"const": "word-template"}},
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {"id": {"const": "analysis-engine"}},
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "relativePath", "sha256", "byteLength"],
        "properties": {
          "id": {
            "enum": ["word-template", "analysis-engine", "tool-definitions", "rules"]
          },
          "version": {"$ref": "#/$defs/version"},
          "relativePath": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)(?![A-Za-z]:)(?![\\\\/]).{1,160}$"
          },
          "sha256": {"$ref": "#/$defs/sha256"},
          "byteLength": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9a-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
